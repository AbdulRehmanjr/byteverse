generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    userId             String           @id @default(cuid())
    userName           String           @unique
    email              String           @unique
    password           String
    Question           Question[]
    QuestionLike       QuestionLike[]
    Answer             Answer[]
    Save               Save[]
    UserProfile        UserProfile?
    userConversations  Conversation[]   @relation("UserConversations")
    guestConversations Conversation[]   @relation("GuestConversations")
    Post               Post[]
    PostLike           PostLike[]
    Comment            Comment[]
    CodeSnippet        CodeSnippet[]
    SnippetLike        SnippetLike[]
    SnippetComment     SnippetComment[]
}

model QuestionLike {
    likeId     String   @id @default(cuid())
    questionId String
    userId     String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    user     User     @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
    question Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade, onUpdate: Cascade)

    @@unique([userId, questionId])
}

model Question {
    questionId String   @id @default(cuid())
    title      String   @default("none")
    content    String   @default("none") @db.Text
    tags       String[] @default([])
    userId     String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    user         User           @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
    QuestionLike QuestionLike[]
    Answer       Answer[]
    Save         Save[]
}

model Answer {
    answerId   String   @id @default(cuid())
    questionId String
    userId     String
    vote       Int      @default(0)
    content    String   @default("none") @db.Text
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    user     User     @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
    question Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade, onUpdate: Cascade)
}

model Save {
    saveId     String   @id @default(cuid())
    userId     String
    questionId String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    question Question @relation(fields: [questionId], references: [questionId], onDelete: Cascade, onUpdate: Cascade)
    user     User     @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
}

model UserProfile {
    profileId            String   @id @default(cuid())
    dp                   String   @default("/placeholder.png")
    userId               String   @unique
    bio                  String?  @db.Text
    role                 String?
    company              String?
    location             String?
    githubUrl            String?
    websiteUrl           String?
    tags                 String[] @default([])
    isVerified           Boolean  @default(false)
    isTopContributor     Boolean  @default(false)
    receiveNotifications Boolean  @default(true)
    showEmail            Boolean  @default(false)
    reputation           Int      @default(0)
    createdAt            DateTime @default(now())
    updatedAt            DateTime @updatedAt

    user User @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
}

model Conversation {
    conversationId String   @id @default(cuid())
    senderId       String   @unique
    receiverId     String   @unique
    senderName     String   @default("none")
    lastMessage    String?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt

    sender   User      @relation("UserConversations", fields: [senderId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
    receiver User      @relation("GuestConversations", fields: [receiverId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
    messages Message[]

    @@index([senderId])
    @@index([receiverId])
}

model Message {
    messageId      String       @id @default(cuid())
    conversationId String
    content        String
    senderId       String
    read           Boolean      @default(false)
    createdAt      DateTime     @default(now())
    updatedAt      DateTime     @updatedAt
    conversation   Conversation @relation(fields: [conversationId], references: [conversationId], onDelete: Cascade)

    @@index([conversationId])
    @@index([createdAt])
}

model Post {
    postId    String   @id @default(cuid())
    content   String   @db.Text
    image     String
    hashTags  String[] @default([])
    userId    String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user     User       @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
    likes    PostLike[]
    comments Comment[]
    views    PostView[]
}

model PostLike {
    id        String   @id @default(cuid())
    postId    String
    userId    String
    createdAt DateTime @default(now())

    post Post @relation(fields: [postId], references: [postId], onDelete: Cascade, onUpdate: Cascade)
    user User @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)

    @@unique([postId, userId])
}

model Comment {
    id        String   @id @default(cuid())
    content   String   @db.Text
    postId    String
    userId    String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    post Post @relation(fields: [postId], references: [postId], onDelete: Cascade, onUpdate: Cascade)
    user User @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
}

model PostView {
    id        String   @id @default(cuid())
    postId    String
    viewerId  String
    createdAt DateTime @default(now())

    post Post @relation(fields: [postId], references: [postId], onDelete: Cascade, onUpdate: Cascade)

    @@unique([postId, viewerId])
}

// Add these models to your existing schema.prisma file

model CodeSnippet {
    snippetId   String   @id @default(cuid())
    title       String
    description String?  @db.Text
    code        String   @db.Text
    language    String
    userId      String
    tags        String[] @default([])
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    user     User             @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
    likes    SnippetLike[]
    comments SnippetComment[]
    views    SnippetView[]
}

model SnippetLike {
    id        String   @id @default(cuid())
    snippetId String
    userId    String
    createdAt DateTime @default(now())

    snippet CodeSnippet @relation(fields: [snippetId], references: [snippetId], onDelete: Cascade, onUpdate: Cascade)
    user    User        @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)

    @@unique([snippetId, userId])
}

model SnippetComment {
    id        String   @id @default(cuid())
    content   String   @db.Text
    snippetId String
    userId    String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    snippet CodeSnippet @relation(fields: [snippetId], references: [snippetId], onDelete: Cascade, onUpdate: Cascade)
    user    User        @relation(fields: [userId], references: [userId], onDelete: Cascade, onUpdate: Cascade)
}

model SnippetView {
    id        String   @id @default(cuid())
    snippetId String
    viewerId  String
    createdAt DateTime @default(now())

    snippet CodeSnippet @relation(fields: [snippetId], references: [snippetId], onDelete: Cascade, onUpdate: Cascade)

    @@unique([snippetId, viewerId])
}
